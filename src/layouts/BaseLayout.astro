            <span class="hidden md:inline">Medium</span>
          </a>

          <!-- GitHub Link -->
          <a href="https://github.com/cloudbypascal" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 transition-all shadow-sm" title="GitHub Profile" aria-label="GitHub Profile">
