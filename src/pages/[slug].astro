---
import { getCollection } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => {
    const relatedPosts = posts
      .filter(candidate => candidate.slug !== post.slug)
      .map(candidate => {
        const categoryScore = candidate.data.category === post.data.category ? 2 : 0;
        const tagScore = candidate.data.tags.filter(t => post.data.tags.includes(t)).length;
        return { candidate, score: categoryScore + tagScore };
      })
      .sort((a, b) => {
        if (b.score !== a.score) return b.score - a.score;
        return new Date(b.candidate.data.date).getTime() - new Date(a.candidate.data.date).getTime();
      })
      .slice(0, 2)
      .map(item => item.candidate);

    return {
      params: { slug: post.slug },
      props: { post, relatedPosts },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const { Content, headings } = await post.render();
---

<PostLayout post={post} headings={headings} relatedPosts={relatedPosts}>
  <Content />
</PostLayout>
