      </div>
    </div>
  </header>

  <!-- Main Slot -->
  <slot />

  <!-- Footer (Full Screen Width) -->
  <footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 py-12 mt-auto w-full">
