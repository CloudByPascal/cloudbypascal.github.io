            </li>
            <li>
              <a href="/sitemap.xml" class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1.5">
                <span>Sitemap XML</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Connect & Feeds -->
        <div class="flex flex-col gap-3">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-white">Connect & Feeds</h3>
          <ul class="flex flex-col space-y-2 text-xs">
            <li>
              <a href="/rss.xml" class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-2">
