---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = (await getCollection('posts')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const categories = ['All', ...Array.from(new Set(allPosts.map(p => p.data.category)))];
---

<BaseLayout>
  <!-- Author Hero Header -->
  <section class="border-b border-slate-200 dark:border-slate-800 bg-gradient-to-b from-white via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 py-14 sm:py-18">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-6">
        <img src="/assets/img/pascal-riester.png" alt="Pascal Riester"
          class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl object-cover object-top ring-4 ring-blue-500/20 shadow-xl shadow-blue-500/10 shrink-0"
          onerror="this.onerror=null; this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%232563eb%22/><text x=%2250%%22 y=%2255%%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 font-size=%2245%22 fill=%22white%22 font-family=%22sans-serif%22 font-weight=%22bold%22>PR</text></svg>'">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800 text-blue-700 dark:text-blue-300 mb-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Microsoft Identity & Access Specialist</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">Pascal Riester</h1>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-1 font-medium">
            Identity & Access Administrator • Microsoft Entra ID • Cloud Security Architect
          </p>
        </div>
      </div>

      <p class="text-base text-slate-700 dark:text-slate-300 max-w-3xl leading-relaxed">
        Specializing in <strong>Microsoft Entra ID (Azure AD)</strong>, <strong>Conditional Access</strong>,
        <strong>Privileged Identity Management (PIM)</strong>, <strong>Identity Governance</strong>, and Zero Trust
        access architecture within the Microsoft Cloud.
      </p>

      <!-- Topic Pills -->
      <div class="flex flex-wrap gap-2 mt-6">
        <span class="text-xs px-3 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 font-medium">🛡️ Microsoft Entra ID</span>
        <span class="text-xs px-3 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 font-medium">🔐 Conditional Access Frameworks</span>
        <span class="text-xs px-3 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 font-medium">⚡ Continuous Access Evaluation (CAE)</span>
        <span class="text-xs px-3 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 font-medium">👑 Privileged Identity Management (PIM)</span>
        <span class="text-xs px-3 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 font-medium">🌐 Zero Trust & Network Security</span>
        <span class="text-xs px-3 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 font-medium">🔄 Identity Lifecycle & Governance</span>
      </div>
    </div>
  </section>

  <!-- Main Article Section -->
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow w-full">
    
    <!-- Controls: Search & Category Filters -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pb-8 border-b border-slate-200 dark:border-slate-800">
      
      <!-- Category Filters -->
      <div class="flex flex-wrap items-center gap-1.5" id="category-filters">
        {categories.map((cat, idx) => (
          <button
            class={`category-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all ${
              idx === 0
                ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-sm active-filter'
                : 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700'
            }`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Search Input -->
      <div class="relative min-w-[240px]">
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="text"
          id="search-input"
          placeholder="Search articles & tags..."
          class="w-full pl-9 pr-4 py-1.5 text-xs rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
        />
      </div>

    </div>

    <!-- Stats Bar -->
    <div class="flex items-center justify-between py-4 text-xs text-slate-500 dark:text-slate-400">
      <div id="articles-count">Showing <span class="font-bold text-slate-900 dark:text-white" id="count-number">{allPosts.length}</span> articles</div>
      <div>Curated technical write-ups</div>
    </div>

    <!-- Article Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4" id="posts-grid">
      {allPosts.map(post => {
        const wordCount = post.body ? post.body.trim().split(/\s+/).length : 500;
        const readingTime = `${Math.ceil(wordCount / 200)} min read`;
        const postUrl = `/${post.slug}/`;

        return (
          <article
            class="post-card rounded-2xl sm:rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 sm:p-8 hover:shadow-xl hover:border-blue-500/40 dark:hover:border-blue-500/40 transition-all flex flex-col justify-between group"
            data-title={post.data.title.toLowerCase()}
            data-summary={post.data.summary.toLowerCase()}
            data-category={post.data.category}
            data-tags={post.data.tags.join(',').toLowerCase()}
          >
            <div>
              <!-- Meta Badges -->
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900">
                  {post.data.category}
                </span>
                <div class="flex items-center gap-2 text-xs text-slate-400">
                  <span>{post.data.date}</span>
                  <span>•</span>
                  <span>{readingTime}</span>
                </div>
              </div>

              <!-- Title -->
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-tight">
                <a href={postUrl} class="focus:outline-none">
                  {post.data.title}
                </a>
              </h2>

              <!-- Summary -->
              <p class="text-sm text-slate-600 dark:text-slate-300 mt-3 line-clamp-3 leading-relaxed">
                {post.data.summary}
              </p>
            </div>

            <div class="mt-6 pt-6 border-t border-slate-100 dark:border-slate-800/80">
              <!-- Tags -->
              {post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {post.data.tags.map((tag: string) => (
                    <span class="text-[11px] px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}

              <!-- Read Action -->
              <a
                href={postUrl}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition-transform"
              >
                <span>Read Full Article</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- No Results Placeholder -->
    <div id="no-results" class="hidden py-16 text-center">
      <div class="w-12 h-12 mx-auto rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h3 class="text-base font-bold text-slate-900 dark:text-white">No matching articles found</h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Try clearing your search query or selecting a different category filter.</p>
    </div>

  </main>

  <!-- Client-Side Filter & Search Script -->
  <script is:inline>
    let activeCategory = 'All';
    const searchInput = document.getElementById('search-input');
    const filterButtons = document.querySelectorAll('.category-filter-btn');
    const postCards = document.querySelectorAll('.post-card');
    const countNumber = document.getElementById('count-number');
    const noResults = document.getElementById('no-results');

    function applyFilter() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let visibleCount = 0;

      postCards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const summary = card.getAttribute('data-summary') || '';
        const category = card.getAttribute('data-category') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchesCat = activeCategory === 'All' || category === activeCategory;
        const matchesQuery = !query || title.includes(query) || summary.includes(query) || tags.includes(query);

        if (matchesCat && matchesQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countNumber) countNumber.textContent = visibleCount;
      if (noResults) noResults.classList.toggle('hidden', visibleCount > 0);
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.className = 'category-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700';
        });

        btn.className = 'category-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-sm active-filter';
        activeCategory = btn.getAttribute('data-category') || 'All';
        applyFilter();
      });
    });

    searchInput?.addEventListener('input', applyFilter);
  </script>
</BaseLayout>
